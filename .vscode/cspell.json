// To run spell check, first install cspell globally:
// npm install -g cspell
// Then run from the project root:
// cspell --gitignore --config .vscode/cspell.json .
{
  "version": "0.2",
  "language": "en",
  "dictionaries": [
    "custom"
  ],
  "dictionaryDefinitions": [
    {
      "name": "custom",
      "path": "./custom-dictionary.txt"
    }
  ],
  "ignorePaths": [
    "addons/**",
    "*.tscn",
    "*.tres",
    "*.uid",
    "*.godot",
    "*.import",
    "*.svg",
    "assets/**",
    "i18n/text.csv",
    "c3_openai_client/utils/c3_http_request.gd"
  ],
  "enableFiletypes": [
    "shellscript",
    "toml"
  ]
}